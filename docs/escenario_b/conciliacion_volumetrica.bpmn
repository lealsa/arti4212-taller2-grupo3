<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Def_conciliacion" targetNamespace="https://petroandes.ejemplo/bpmn/conciliacion" exporter="generar_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Colab_conciliacion">
    <bpmn:documentation>Gestión de una diferencia de balance volumétrico — Taller 2, Escenario B. Frontera: D determinista, A agéntico, H humano (ver documentation de cada nodo).</bpmn:documentation>
    <bpmn:participant id="P_andes" name="AndesTransporte — conciliación volumétrica del tramo" processRef="Proc_conciliacion"/>
    <bpmn:participant id="P_regulador" name="Regulador sectorial"/>
    <bpmn:messageFlow id="mf_reporte" name="Reporte mensual consolidado" sourceRef="enviar" targetRef="P_regulador"/>
  </bpmn:collaboration>
  <bpmn:message id="Msg_reporte" name="Reporte mensual de pérdidas"/>
  <bpmn:error id="Err_presupuesto" name="Presupuesto agotado" errorCode="PRESUPUESTO_AGOTADO"/>
  <bpmn:error id="Err_balance" name="Balance no disponible" errorCode="BALANCE_NO_DISPONIBLE"/>
  <bpmn:process id="Proc_conciliacion" name="Gestión de una diferencia de balance volumétrico" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L1" name="Sistema de balance volumétrico">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_tol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archivar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_archivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_balance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Orquestador de conciliación (copiloto)">
        <bpmn:flowNodeRef>correlacionar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>investigar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_incidente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_plazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_presupuesto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3" name="Analista de medición del tramo">
        <bpmn:flowNodeRef>manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_dec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4" name="Gerencia de Medición">
        <bpmn:flowNodeRef>cierre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L5" name="Gerencia de Seguridad Física">
        <bpmn:flowNodeRef>hurto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_hurto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>escalar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_esc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L6" name="Gerencia de Cumplimiento">
        <bpmn:flowNodeRef>consolidar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Corte semanal o mensual">
      <bpmn:documentation>Evento</bpmn:documentation>
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td_inicio"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1W</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="calcular" name="Calcular diferencia del tramo [PRO-MED-007 §2]">
      <bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_tol" name="¿|diferencia| ≤ 0,5 %?">
      <bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="archivar" name="Archivar sin investigación [§3.1]">
      <bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fin_archivo" name="Archivado">
      <bpmn:documentation>Evento</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="correlacionar" name="Correlacionar con anomalías de presión [PRO-OPE-012 §3.2]">
      <bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw_sust" name="¿Sospecha de sustracción?">
      <bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="hurto" name="Atender evento de hurto [PRO-SEG-015]">
      <bpmn:documentation>Frontera: HUMANO</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="fin_hurto" name="Caso trasladado a Seguridad Física">
      <bpmn:documentation>Evento</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_esc" name="¿|diferencia| &gt; 1 %?">
      <bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_par" name="">
      <bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="escalar" name="Atender escalamiento el mismo día [§3.3]">
      <bpmn:documentation>Frontera: HUMANO</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fin_esc" name="Escalamiento atendido">
      <bpmn:documentation>Evento</bpmn:documentation>
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_merge" name="">
      <bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="investigar" name="Investigar causas, redactar y validar borrador">
      <bpmn:documentation>Frontera: AGÉNTICO</bpmn:documentation>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:startEvent id="sp_inicio"><bpmn:outgoing>sf1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="sp_contexto" name="Cargar contexto del caso (balance, mediciones, OT, procedimientos vigentes)"><bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation><bpmn:incoming>sf1</bpmn:incoming><bpmn:outgoing>sf2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:task id="sp_investigar" name="Investigar causas plausibles (bucle con herramientas de lectura)"><bpmn:documentation>Frontera: AGÉNTICO</bpmn:documentation><bpmn:incoming>sf2</bpmn:incoming><bpmn:incoming>sf6</bpmn:incoming><bpmn:outgoing>sf3</bpmn:outgoing></bpmn:task>
      <bpmn:task id="sp_redactar" name="Redactar borrador con citas"><bpmn:documentation>Frontera: AGÉNTICO</bpmn:documentation><bpmn:incoming>sf3</bpmn:incoming><bpmn:outgoing>sf4</bpmn:outgoing></bpmn:task>
      <bpmn:serviceTask id="sp_validar" name="Validar cifras y citas del borrador"><bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation><bpmn:incoming>sf4</bpmn:incoming><bpmn:outgoing>sf5</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="sp_gw" name="¿Válido?"><bpmn:incoming>sf5</bpmn:incoming><bpmn:outgoing>sf6</bpmn:outgoing><bpmn:outgoing>sf7</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="sp_fin" name="Borrador validado"><bpmn:incoming>sf7</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="sf1" sourceRef="sp_inicio" targetRef="sp_contexto"/>
      <bpmn:sequenceFlow id="sf2" sourceRef="sp_contexto" targetRef="sp_investigar"/>
      <bpmn:sequenceFlow id="sf3" sourceRef="sp_investigar" targetRef="sp_redactar"/>
      <bpmn:sequenceFlow id="sf4" sourceRef="sp_redactar" targetRef="sp_validar"/>
      <bpmn:sequenceFlow id="sf5" sourceRef="sp_validar" targetRef="sp_gw"/>
      <bpmn:sequenceFlow id="sf6" name="no (máx. 2 reintentos)" sourceRef="sp_gw" targetRef="sp_investigar"/>
      <bpmn:sequenceFlow id="sf7" name="sí" sourceRef="sp_gw" targetRef="sp_fin"/>
    </bpmn:subProcess>
    <bpmn:userTask id="manual" name="Investigar y elaborar acta manualmente">
      <bpmn:documentation>Frontera: HUMANO</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="revisar" name="Revisar y decidir sobre el borrador (≤ 2 min)">
      <bpmn:documentation>Frontera: HUMANO</bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_dec" name="¿Decisión?">
      <bpmn:documentation>Frontera: HUMANO</bpmn:documentation>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="registrar" name="Registrar acta de conciliación (idempotente)">
      <bpmn:documentation>Frontera: DETERMINISTA</bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="cierre" name="Aprobar cierre del período [§4]">
      <bpmn:documentation>Frontera: HUMANO</bpmn:documentation>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="consolidar" name="Consolidar reporte mensual de pérdidas [RES-ANH-0471 Art. 3]">
      <bpmn:documentation>Frontera: HUMANO</bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="enviar" name="Enviar reporte al regulador (≤ 15 días)" messageRef="Msg_reporte">
      <bpmn:documentation>Frontera: HUMANO</bpmn:documentation>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="fin" name="Período cerrado y reportado">
      <bpmn:documentation>Evento</bpmn:documentation>
      <bpmn:incoming>f27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="fin_incidente" name="Incidente a plataforma; corte reprogramado">
      <bpmn:documentation>Evento</bpmn:documentation>
      <bpmn:incoming>f28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="b_plazo" name="3 días hábiles sin borrador aprobado" attachedToRef="investigar" cancelActivity="true">
      <bpmn:documentation>Evento</bpmn:documentation>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td_b_plazo"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_presupuesto" name="Presupuesto agotado o evidencia insuficiente" attachedToRef="investigar" cancelActivity="true">
      <bpmn:documentation>Evento</bpmn:documentation>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ed_b_presupuesto" errorRef="Err_presupuesto"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_balance" name="Balance no disponible" attachedToRef="calcular" cancelActivity="true">
      <bpmn:documentation>Evento</bpmn:documentation>
      <bpmn:outgoing>f28</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ed_b_balance" errorRef="Err_balance"/>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="inicio" targetRef="calcular"/>
    <bpmn:sequenceFlow id="f2" sourceRef="calcular" targetRef="gw_tol"/>
    <bpmn:sequenceFlow id="f3" name="sí" sourceRef="gw_tol" targetRef="archivar"/>
    <bpmn:sequenceFlow id="f4" sourceRef="archivar" targetRef="fin_archivo"/>
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gw_tol" targetRef="correlacionar"/>
    <bpmn:sequenceFlow id="f6" sourceRef="correlacionar" targetRef="gw_sust"/>
    <bpmn:sequenceFlow id="f7" name="sí" sourceRef="gw_sust" targetRef="hurto"/>
    <bpmn:sequenceFlow id="f8" sourceRef="hurto" targetRef="fin_hurto"/>
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="gw_sust" targetRef="gw_esc"/>
    <bpmn:sequenceFlow id="f10" name="sí" sourceRef="gw_esc" targetRef="gw_par"/>
    <bpmn:sequenceFlow id="f11" sourceRef="gw_par" targetRef="escalar"/>
    <bpmn:sequenceFlow id="f12" sourceRef="escalar" targetRef="fin_esc"/>
    <bpmn:sequenceFlow id="f13" sourceRef="gw_par" targetRef="gw_merge"/>
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="gw_esc" targetRef="gw_merge"/>
    <bpmn:sequenceFlow id="f15" sourceRef="gw_merge" targetRef="investigar"/>
    <bpmn:sequenceFlow id="f16" name="borrador validado" sourceRef="investigar" targetRef="revisar"/>
    <bpmn:sequenceFlow id="f17" name="aprobar" sourceRef="gw_dec" targetRef="registrar"/>
    <bpmn:sequenceFlow id="f18" name="devolver con observaciones" sourceRef="gw_dec" targetRef="gw_merge"/>
    <bpmn:sequenceFlow id="f19" name="rechazar" sourceRef="gw_dec" targetRef="manual"/>
    <bpmn:sequenceFlow id="f20" sourceRef="revisar" targetRef="gw_dec"/>
    <bpmn:sequenceFlow id="f21" sourceRef="b_plazo" targetRef="manual"/>
    <bpmn:sequenceFlow id="f22" sourceRef="b_presupuesto" targetRef="manual"/>
    <bpmn:sequenceFlow id="f23" name="acta firmada por el analista" sourceRef="manual" targetRef="registrar"/>
    <bpmn:sequenceFlow id="f24" sourceRef="registrar" targetRef="cierre"/>
    <bpmn:sequenceFlow id="f25" sourceRef="cierre" targetRef="consolidar"/>
    <bpmn:sequenceFlow id="f26" sourceRef="consolidar" targetRef="enviar"/>
    <bpmn:sequenceFlow id="f27" sourceRef="enviar" targetRef="fin"/>
    <bpmn:sequenceFlow id="f28" name="reintentos agotados" sourceRef="b_balance" targetRef="fin_incidente"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Colab_conciliacion">
      <bpmndi:BPMNShape id="P_andes_di" bpmnElement="P_andes" isHorizontal="true"><dc:Bounds x="150" y="40" width="2406" height="744"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L1_di" bpmnElement="L1" isHorizontal="true"><dc:Bounds x="180" y="40" width="2376" height="124"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_di" bpmnElement="L2" isHorizontal="true"><dc:Bounds x="180" y="164" width="2376" height="124"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L3_di" bpmnElement="L3" isHorizontal="true"><dc:Bounds x="180" y="288" width="2376" height="124"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L4_di" bpmnElement="L4" isHorizontal="true"><dc:Bounds x="180" y="412" width="2376" height="124"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L5_di" bpmnElement="L5" isHorizontal="true"><dc:Bounds x="180" y="536" width="2376" height="124"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L6_di" bpmnElement="L6" isHorizontal="true"><dc:Bounds x="180" y="660" width="2376" height="124"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_regulador_di" bpmnElement="P_regulador" isHorizontal="true"><dc:Bounds x="150" y="824" width="2406" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio"><dc:Bounds x="340" y="84" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="calcular_di" bpmnElement="calcular"><dc:Bounds x="434" y="66" width="112" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_tol_di" bpmnElement="gw_tol" isMarkerVisible="true"><dc:Bounds x="597" y="77" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="archivar_di" bpmnElement="archivar"><dc:Bounds x="698" y="66" width="112" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_archivo_di" bpmnElement="fin_archivo"><dc:Bounds x="868" y="84" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="correlacionar_di" bpmnElement="correlacionar"><dc:Bounds x="698" y="190" width="112" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_sust_di" bpmnElement="gw_sust" isMarkerVisible="true"><dc:Bounds x="861" y="201" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hurto_di" bpmnElement="hurto"><dc:Bounds x="830" y="562" width="112" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_hurto_di" bpmnElement="fin_hurto"><dc:Bounds x="1000" y="580" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_esc_di" bpmnElement="gw_esc" isMarkerVisible="true"><dc:Bounds x="993" y="201" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_par_di" bpmnElement="gw_par"><dc:Bounds x="1125" y="201" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="escalar_di" bpmnElement="escalar"><dc:Bounds x="1226" y="562" width="112" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_esc_di" bpmnElement="fin_esc"><dc:Bounds x="1396" y="580" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_di" bpmnElement="gw_merge" isMarkerVisible="true"><dc:Bounds x="1257" y="201" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="investigar_di" bpmnElement="investigar" isExpanded="false"><dc:Bounds x="1352" y="184" width="124" height="84"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manual_di" bpmnElement="manual"><dc:Bounds x="1490" y="314" width="112" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="revisar_di" bpmnElement="revisar"><dc:Bounds x="1622" y="314" width="112" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_dec_di" bpmnElement="gw_dec" isMarkerVisible="true"><dc:Bounds x="1785" y="325" width="50" height="50"/></bpmndi:BPMNShape>
